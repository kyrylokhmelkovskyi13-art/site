# Discord OAuth2 application credentials (server-side only).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match the OAuth2 Redirect URI configured in the Discord Developer Portal.
DISCORD_REDIRECT_URI=https://YOUR-BOTCONTROL.onrender.com/auth/discord/callback
# Your Discord user ID. This account is the BotControl owner.
BOTCONTROL_OWNER_DISCORD_ID=

# Generate a long random secret; keep it only in Render environment settings.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Supabase project URL and service-role key. Never expose the service-role key to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Render API key and bot-to-panel shared secret.
RENDER_API_TOKEN=
BOTCONTROL_SHARED_SECRET=replace-with-a-long-random-secret

# JSON array. Replace the Render service ID and bot service URL with the real values.
BOT_SERVICES=[{"id":"ivynx","name":"Kingdom of IvynX","renderServiceId":"srv-dbssmff3r2c73b9d05g","controlUrl":"https://ivynx.onrender.com"}]
NODE_ENV=production
