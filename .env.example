# Never commit real values. Set these in the hosting provider's secret environment settings.
OWNER_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
RENDER_API_TOKEN=
# Use the same random secret in the IvynX Render service as BOTCONTROL_SHARED_SECRET.
BOTCONTROL_SHARED_SECRET=replace-with-a-long-random-secret
# JSON array. Replace controlUrl if the IvynX service has a different public URL.
BOT_SERVICES=[{"id":"ivynx","name":"Kingdom of IvynX","renderServiceId":"srv-dbssmff3r2c73b9d05g","controlUrl":"https://ivynx.onrender.com"}]
NODE_ENV=production

# Add VOID after deploying its Render Worker; replace srv-... and URL with actual values.
